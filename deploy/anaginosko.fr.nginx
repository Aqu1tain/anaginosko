server {
    server_name anaginosko.fr www.anaginosko.fr;
    root /var/www/anaginosko;

    gzip on;
    gzip_vary on;
    gzip_types application/json application/javascript text/css image/svg+xml text/plain application/manifest+json;
    gzip_min_length 512;

    location /.well-known/acme-challenge/ {
        root /var/www/html;
    }

    # backend AdonisJS (conteneur Docker, écoute en local uniquement) — inchangé
    location /api/ {
        proxy_pass http://127.0.0.1:3900;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_read_timeout 30s;
    }

    # --- Servis DIRECTEMENT depuis le disque par nginx (gagnent sur le proxy /) ---

    # manifeste audio : cache court (match exact, priorité maximale)
    location = /audio/manifest.json {
        expires 5m;
        add_header Cache-Control "public, max-age=300";
    }

    # audio mp3 (~30k, ~392 Mo) : immuable, jamais proxifié vers Next
    location ^~ /audio/ {
        expires 1y;
        add_header Cache-Control "public, immutable";
        access_log off;
    }

    # données NT : UNIQUEMENT les fichiers .json (lus au build pour le SSG,
    # fetchés au runtime par le client) sont servis depuis le disque. Les routes
    # de page (/nt, /nt/jn, /nt/jn/1) NE matchent pas et tombent sur Next.
    location ~ ^/(nt|lxx)/.+\.json$ {
        root /var/www/anaginosko;
        expires 5m;
        add_header Cache-Control "public, max-age=300";
        try_files $uri =404;
    }

    # robots.txt et sitemap : jamais limités (un robots.txt en erreur fait suspendre
    # l'exploration de Google pendant 12 h).
    location ~ ^/(robots\.txt|sitemap\.xml|llms\.txt)$ {
        proxy_pass http://127.0.0.1:3100;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    # Robot au-delà de son débit : 429 avec Retry-After, que les robots sérieux respectent.
    location @anag_throttled {
        add_header Retry-After 60 always;
        return 429;
    }

    # --- Tout le reste : l'app Next (SSG/SSR) sur 127.0.0.1:3100 ---
    location / {
        limit_req zone=anag_crawlers burst=20 nodelay;
        limit_req_status 429;
        error_page 429 = @anag_throttled;
        proxy_pass http://127.0.0.1:3100;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_read_timeout 60s;
    }

    listen 443 ssl; # managed by Certbot
    listen [::]:443 ssl ipv6only=on; # managed by Certbot
    ssl_certificate /etc/letsencrypt/live/anaginosko.fr/fullchain.pem; # managed by Certbot
    ssl_certificate_key /etc/letsencrypt/live/anaginosko.fr/privkey.pem; # managed by Certbot
    include /etc/letsencrypt/options-ssl-nginx.conf; # managed by Certbot
    ssl_dhparam /etc/letsencrypt/ssl-dhparams.pem; # managed by Certbot
}
server {
    if ($host = www.anaginosko.fr) { return 301 https://$host$request_uri; } # managed by Certbot
    if ($host = anaginosko.fr) { return 301 https://$host$request_uri; } # managed by Certbot
    listen 80;
    listen [::]:80;
    server_name anaginosko.fr www.anaginosko.fr;
    return 404; # managed by Certbot
}
