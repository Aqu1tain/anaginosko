# Variables publiques exposées au navigateur (NEXT_PUBLIC_*).
# Toute variable absente désactive proprement la fonctionnalité associée.

# Base de l'API (défaut: /api en prod via nginx)
NEXT_PUBLIC_API_BASE=/api
# Base des fichiers audio (défaut: /audio/)
NEXT_PUBLIC_AUDIO_BASE=/audio/

# --- Analytics : Matomo auto-hébergé (anonyme, sans cookie) ---
# Sans ces deux variables, aucune mesure n'est émise.
NEXT_PUBLIC_MATOMO_URL=https://analytics.anaginosko.fr/
NEXT_PUBLIC_MATOMO_SITE_ID=1
