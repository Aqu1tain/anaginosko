<span class=\"ital\">etc. ;</span> <span class=\"ital\">dat.</span>\n<span class=\"grec\">γούνεσσι,</span> <span class=\"aut\">Il.</span>\n<span class=\"refch\">9, 488 ;</span> <span class=\"refch\">17, 451 et\n569 ;</span> <span class=\"ital\">acc.</span> <span class=\"grec\">γοῦνα,</span> <span class=\"aut\">Il.</span> <span class=\"refch\">8, 371 ;</span> <span class=\"aut\">Od.</span> <span class=\"refch\">18, 395,</span> <span class=\"ital\">etc.</span></div>\n</div>\n<div class=\"etymrev\"><span class=\"etiqetymrev\">Étym.</span>\n<span class=\"ital\">indo-europ.</span> <span class=\"indoeurop\">*ǵenu, *ǵonu,</span> genou ; <span class=\"ital\">cf.\nlat.</span> <span class=\"lat\">gĕnu,</span> <span class=\"ital\">sscr.</span> <span class=\"sscr\">jā́nu</span>.</div>\n"}]}