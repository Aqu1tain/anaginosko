 <span class=\"ital\">au\nsens moy.</span> <span class=\"aut\">Plat.</span> <span class=\"oeuv\">Leg.</span> <span class=\"refpa\">722</span><span class=\"refpb\">c</span>, <span class=\"oeuv\">Hipp. mi.</span> <span class=\"refpa\">364</span><span class=\"refpb\">a</span>. <span class=\"ital\">Moy. impf. dor.</span> <span class=\"grec\">ἀρχόμαν,</span>\n<span class=\"aut\">Pd.</span> <span class=\"oeuv\">P.</span>\n<span class=\"refch\">4, 30 ;</span> <span class=\"ital\">ion.</span>\n<span class=\"grec\">ἀρχόμην,</span> <span class=\"aut\">Hdt.</span>\n<span class=\"refch\">5, 51 ;</span> <span class=\"refch\">6,\n75</span>. <span class=\"ital\">Fut.</span> <span class=\"grec\">ἄρξομαι,</span> <span class=\"ital\">qqf. au sens pass.</span>\n<span class=\"aut\">Pd.</span> <span class=\"oeuv\">O.</span>\n<span class=\"refch\">8, 45 ;</span> <span class=\"aut\">Hdt.</span>\n<span class=\"refch\">3, 83 ;</span> <span class=\"aut\">Eschl.</span>\n<span class=\"oeuv\">Pers.</span> <span class=\"refch\">589 ;</span>\n<span class=\"aut\">Lys.</span> <span class=\"refch\">180, 6,</span>\n<span class=\"ital\">etc. ;</span> <span class=\"ital\">fut.\ndor.</span> <span class=\"grec\">ἀρξεῦμαι,</span> <span class=\"aut\">Thcr.</span> <span class=\"oeuv\">Idyl.</span> <span class=\"refch\">7, 95</span>. <span class=\"ital\">Ao.</span> <span class=\"grec\">ἠρξάμην,</span> <span class=\"aut\">Od.</span> <span class=\"refch\">23, 310 ;</span> <span class=\"aut\">Eschl.</span>\n<span class=\"oeuv\">Pr.</span> <span class=\"refch\">199 ;</span>\n<span class=\"aut\">Soph.</span> <span class=\"oeuv\">O.C.</span>\n<span class=\"refch\">625 ;</span> <span class=\"aut\">Thc.</span>\n<span class=\"refch\">6, 46,</span> <span class=\"ital\">etc.</span>\n<span class=\"ital\">Dor.</span> <span class=\"grec\">ἀρξάμην,</span>\n<span class=\"aut\">Sim.</span> <span class=\"refch\">fr. 46 ;</span>\n<span class=\"aut\">Thcr.</span> <span class=\"oeuv\">Idyl.</span>\n<span class=\"refch\">6, 5 ;</